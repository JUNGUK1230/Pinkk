<?xml version="1.0"?>
<package format="3">
  <name>pinkk_handeye_automation</name>
  <version>0.1.0</version>
  <description>Pinkk 로봇의 Eye-in-hand 자동 자세 이동 및 Easy Handeye2 샘플 수집</description>
  <maintainer email="juwon@example.com">juwon</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>easy_handeye2_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
