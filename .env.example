# 중앙 서버
PINKK_API_KEY=replace-with-a-long-random-secret
PINKK_ADMIN_KEY=replace-with-a-different-admin-secret
PINKK_ALLOWED_ORIGINS=https://parking.example.com
PINKK_ENABLE_VISION=0
PINKK_ENABLE_LOCAL_ROS=0

# 운영 노트북(각 장비에서 ROBOT_ID만 다르게 설정)
ROBOT_ID=pinky1
CENTRAL_SERVER_URL=https://parking.example.com
PINKK_BATTERY_PERCENT_TOPIC=/battery/percent
PINKK_BATTERY_VOLTAGE_TOPIC=/battery/voltage
PINKK_COMMAND_TOPIC=/pinkk/command
PINKK_COMMAND_POLL_INTERVAL=1.0
PINKK_SEND_INTERVAL=1.5
PINKK_HTTP_TIMEOUT=3.0
PINKK_ROBOT_STATUS=idle
